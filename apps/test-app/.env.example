# Copy to .env and fill in. Loaded automatically when you run via
# `node --env-file=.env src/cli.mjs [--vm <evm|solana>] <cmd>`.
#
# Most env vars are VM-agnostic. Only the wallet (seed + derivation path + RPC)
# changes between EVM and Solana — see notes below.

# ---------------------------------------------------------------------------
# Wallet (shared) — used by both --vm evm (default) and --vm solana
# ---------------------------------------------------------------------------
LAYERSWAP_SEED="cook voyage document eight skate token alien guide drink uncle term abuse"

# --vm evm    : standard BIP-44 EVM path, e.g. "0'/0/0".
# --vm solana : every segment must be hardened (end with '), e.g. "0'/0'/0'".
#               If you leave the default below, the Solana account builder
#               auto-substitutes "0'/0'/0'" so one .env can serve both VMs.
LAYERSWAP_DERIVATION_PATH="0'/0/0"

# Source-chain RPC URL. Switch this when you switch --vm.
# --vm evm    : an EVM JSON-RPC endpoint (Ethereum / Arbitrum / etc.)
# --vm solana : a Solana JSON-RPC endpoint (https://api.devnet.solana.com,
#               https://api.mainnet-beta.solana.com, or a private RPC)
LAYERSWAP_SOURCE_RPC="https://eth-sepolia.g.alchemy.com/v2/REPLACE_ME"

# ---------------------------------------------------------------------------
# Route — Layerswap uses the <CHAIN>_<ENV> uppercase convention. Run
# `cli.mjs networks` to list what the configured endpoint supports.
# ---------------------------------------------------------------------------
LAYERSWAP_TARGET_CHAIN="ARBITRUM_SEPOLIA"
LAYERSWAP_SOURCE_TOKEN="ETH"
LAYERSWAP_DEST_TOKEN="ETH"

# Amount in base units of LAYERSWAP_SOURCE_TOKEN.
#   EVM ETH (18 decimals): 10000000000000000  = 0.01 ETH
#   SOL    (9 decimals):   10000000           = 0.01 SOL
#   USDC   (6 decimals):   10000000           = 10 USDC
LAYERSWAP_AMOUNT="10000000000000000"

# LAYERSWAP_RECIPIENT defaults to the source wallet address (round-trip).
# Set explicitly to send to a different destination address.
# LAYERSWAP_RECIPIENT="0x..."

# Optional — override auto-detected source network name (e.g. when the RPC's
# genesis hash isn't in the auto-detect table or you have a custom cluster).
# LAYERSWAP_SOURCE_CHAIN="SOLANA_MAINNET"

# Optional Bitcoin-only fee rate override in sat/vB. Useful on testnet when a
# public Blockbook server returns an unrealistic fee estimate.
# LAYERSWAP_BTC_FEE_RATE="2"

# ---------------------------------------------------------------------------
# Layerswap endpoint (sandbox is default)
# ---------------------------------------------------------------------------
LAYERSWAP_API_URL="https://api-dev.layerswap.cloud"
# Use "sandbox" for api-dev. Set this to an empty string when using the public
# production endpoint unless you have a production API key.
LAYERSWAP_API_KEY="sandbox"

# ---------------------------------------------------------------------------
# Polling for the `swidge` command
# ---------------------------------------------------------------------------
LAYERSWAP_POLL_INTERVAL_MS="10000"
LAYERSWAP_POLL_TIMEOUT_MS="900000"
