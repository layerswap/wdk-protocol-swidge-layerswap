# Copy to .env and fill in. Loaded automatically when you run via `node --env-file=.env src/cli.mjs <cmd>`.

# Source wallet
LAYERSWAP_SEED="cook voyage document eight skate token alien guide drink uncle term abuse"
LAYERSWAP_DERIVATION_PATH="0'/0/0"
LAYERSWAP_SOURCE_RPC="https://eth-sepolia.g.alchemy.com/v2/REPLACE_ME"

# Route — Layerswap uses the <CHAIN>_<ENV> uppercase convention (e.g. ETHEREUM_MAINNET,
# ARBITRUM_MAINNET, ETHEREUM_SEPOLIA, ARBITRUM_SEPOLIA). Run `cli.mjs networks` to list.
LAYERSWAP_TARGET_CHAIN="ARBITRUM_SEPOLIA"
LAYERSWAP_SOURCE_TOKEN="ETH"
LAYERSWAP_DEST_TOKEN="ETH"
LAYERSWAP_AMOUNT="10000000000000000"
# LAYERSWAP_RECIPIENT defaults to source wallet address (round-trip)

# Layerswap endpoint (sandbox is default)
LAYERSWAP_API_URL="https://api-dev.layerswap.cloud"
LAYERSWAP_API_KEY="sandbox"

# Polling for `bridge` command
LAYERSWAP_POLL_INTERVAL_MS="10000"
LAYERSWAP_POLL_TIMEOUT_MS="900000"
