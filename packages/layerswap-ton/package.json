{
  "name": "@layerswap/wdk-protocol-bridge-layerswap-ton",
  "version": "1.0.0-beta.1",
  "description": "WDK Swidge module that lets @tetherto/wdk-wallet-ton wallet accounts swap and bridge tokens across chains via the Layerswap public API, using the ISwidgeProtocol interface.",
  "keywords": [
    "wdk",
    "protocol",
    "swidge",
    "swap",
    "bridge",
    "layerswap",
    "ton"
  ],
  "author": "Aren <aren@bransfer.io>",
  "license": "Apache-2.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@layerswap/wdk-protocol-bridge-layerswap-core": "workspace:*",
    "bare-node-runtime": "^1.1.4"
  },
  "peerDependencies": {
    "@tetherto/wdk-wallet": ">=1.0.0-beta.16",
    "@tetherto/wdk-wallet-ton": ">=1.0.0-beta.7",
    "@ton/ton": ">=15.0.0"
  },
  "devDependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.16",
    "@tetherto/wdk-wallet-ton": "1.0.0-beta.12",
    "@ton/ton": "15.1.0",
    "cross-env": "10.0.0",
    "jest": "30.0.5",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js",
      "tests/**/*.mjs",
      "types/**/*"
    ]
  },
  "directories": {
    "test": "tests"
  }
}
