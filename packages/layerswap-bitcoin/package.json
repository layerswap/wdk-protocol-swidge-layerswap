{
  "name": "@layerswap/wdk-protocol-swidge-layerswap-bitcoin",
  "version": "1.0.0-beta.1",
  "description": "WDK Swidge module that lets @tetherto/wdk-wallet-btc wallet accounts swap and bridge bitcoin across chains via the Layerswap public API, using the ISwidgeProtocol interface.",
  "keywords": [
    "wdk",
    "protocol",
    "swidge",
    "swap",
    "bridge",
    "layerswap",
    "bitcoin"
  ],
  "author": "Aren <aren@bransfer.io>",
  "license": "Apache-2.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@bitcoinerlab/coinselect": "2.0.1",
    "@bitcoinerlab/descriptors": "3.1.7",
    "@layerswap/wdk-protocol-swidge-layerswap-core": "workspace:*",
    "bare-node-runtime": "^1.5.0",
    "bitcoinjs-lib": "7.0.1"
  },
  "peerDependencies": {
    "@tetherto/wdk-wallet": ">=1.0.0-beta.17",
    "@tetherto/wdk-wallet-btc": ">=1.0.0-beta.14"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@tetherto/wdk-wallet": "1.0.0-beta.17",
    "@tetherto/wdk-wallet-btc": "1.0.0-beta.14",
    "bip32": "5.0.1",
    "cross-env": "10.1.0",
    "jest": "30.4.2",
    "standard": "17.1.2",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js",
      "tests/**/*.mjs",
      "types/**/*"
    ]
  },
  "directories": {
    "test": "tests"
  }
}
